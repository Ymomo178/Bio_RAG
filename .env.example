# PostgreSQL 容器；以下默认账号只用于本地开发。
POSTGRES_DB=biorag
POSTGRES_USER=biorag
POSTGRES_PASSWORD=biorag_dev
POSTGRES_PORT=5432
# Java 在宿主机运行时使用 JDBC，账号需与上面的 PostgreSQL 容器保持一致。
DB_URL=jdbc:postgresql://localhost:5432/biorag
DB_USERNAME=biorag
DB_PASSWORD=biorag_dev

# Docker build and ports
DOCKER_REGISTRY=docker.m.daocloud.io
MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
WEB_PORT=5173
JAVA_PORT=8080
PYTHON_PORT=8000
# 仅本地 HTTP 使用 false；通过 HTTPS 访问时必须设置为 true。
SESSION_COOKIE_SECURE=false

# GHCR 预构建镜像；Fork 仓库或固定版本标签时覆盖这些地址。
WEB_IMAGE=ghcr.io/ymomo178/bio-rag-web:latest
BACKEND_IMAGE=ghcr.io/ymomo178/bio-rag-backend-java:latest
AI_SERVICE_IMAGE=ghcr.io/ymomo178/bio-rag-ai-service:latest

# Java backend
SERVER_PORT=8080
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_CONNECT_TIMEOUT=3s
AI_SERVICE_READ_TIMEOUT=300s
MAX_FILE_SIZE=25MB
MAX_REQUEST_SIZE=25MB
UPLOAD_ROOT=../uploads
UPLOAD_ARTIFACT_ROOT=../artifacts/uploads

# Python 在宿主机运行时使用 psycopg 连接串；Compose 会自动替换为 host=postgres。
AI_SERVICE_PORT=8000
AI_DATABASE_URL=host=localhost port=5432 dbname=biorag user=biorag password=biorag_dev
DATABASE_CONNECT_TIMEOUT_SECONDS=5
MAX_CONCURRENT_RETRIEVALS=2
MAX_CONCURRENT_GENERATIONS=4
# 6 GB 显存建议保持 1；显存更大时可按压测结果提高。
GPU_MAX_CONCURRENT_RETRIEVALS=1
HF_ENDPOINT=https://hf-mirror.com

# OpenAI compatible LLM
LLM_PROVIDER=qwen
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3.7-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.1

# Retrieval models
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=4
MODEL_LOCAL_FILES_ONLY=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Hugging Face 无法访问时，可填写 ModelScope 下载后的本地模型目录
RERANKER_MODEL_PATH=
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=4
DENSE_CANDIDATE_COUNT=100
KEYWORD_CANDIDATE_COUNT=100
RERANK_CANDIDATE_COUNT=100
# 高于该分数使用知识库证据，低于该分数由 LLM 通用知识兜底
MIN_EVIDENCE_SCORE=0.85
APP_ADMIN_EMAIL=admin@example.com
